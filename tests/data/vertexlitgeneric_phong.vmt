// Example VertexLitGeneric material with phong shading.
"VertexLitGeneric"
{
    "$basetexture" "models/props/cs_office/computer"
    "$phong" "1"
    "$phongexponent" "25"
    "$phongboost" "6"
    "$phongfresnelranges" "[.25 .5 1]"

    // Specular tint applied on top of the fresnel term
    "$phongtint" "[.8 .9 1]"

    "$bumpmap" "models/props/cs_office/computer_normal"
    "$normalmapalphaenvmapmask" "1"
    "$envmap" "env_cubemap"
}
