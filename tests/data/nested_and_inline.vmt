"VertexLitGeneric"
{
    "$basetexture" "models/props/de_dust/dust_wall"
    "$envmap" "{  }"
    "$basetexturetransform" "center .5 .5 scale 1 1 rotate 0 translate 0 0"
    "$color2" "[1 .5 0]"

    "Proxies"
    {
        "Sine"
        {
            "sineperiod" "2"
            "sinemin" "0"
            "sinemax" "1"
            "resultvar" "$alpha"
        }

        "Multiply"
        {
            "srcvar1" "$color2"
            "resultvar" "$color"
        }
    }
}
