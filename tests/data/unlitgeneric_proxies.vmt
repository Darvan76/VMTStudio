"UnlitGeneric"
{
    "$basetexture" "effects/blueflare1"
    "$additive" "1"
    "$translucent" "1"

    "Proxies"
    {
        "TextureScroll"
        {
            "texturescrollvar" "$basetexturetransform"
            "texturescrollrate" "0.1"
            "texturescrollangle" "0"
        }
    }
}
