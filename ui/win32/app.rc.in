// Generated from ui/win32/app.rc.in - do not edit the generated copy.
//
// Embed the application version, icon and generated manifest so
// that the process declares Common Controls v6 and Per-Monitor V2 DPI
// awareness. Both are load-bearing for the Win32 shell work - without the
// manifest the common controls render in the classic pre-Vista style and
// Windows bitmap-scales the whole window on HiDPI monitors.
//
// The manifest and icon paths are baked in by CMake (configure_file, @ONLY) as
// absolute paths so the resource compiler never depends on its working
// directory and no /D define has to survive the trip to rc.exe.

#include <windows.h>

#define IDI_APP_ICON 101
IDI_APP_ICON ICON "@VMTSTUDIO_ICON_PATH@"

1 RT_MANIFEST "@VMTVIEWER_MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VMT-Studio Contributors\0"
            VALUE "FileDescription", "VMT-Studio material editor\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "vmtstudio\0"
            VALUE "OriginalFilename", "vmtstudio.exe\0"
            VALUE "ProductName", "VMT-Studio\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
